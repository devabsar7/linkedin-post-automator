# =============================================================================
# Cloudflare Pages build variables (SAFE / PUBLIC only)
# Set these in Cloudflare Pages → Settings → Environment variables
# Never put server secrets here — they would be baked into the static bundle.
# =============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# =============================================================================
# Local frontend development only (copy to .env.local — never commit values)
# =============================================================================
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# =============================================================================
# Supabase Edge Function secrets
# Set via: supabase secrets set KEY=value
# Or Dashboard → Project Settings → Edge Functions → Secrets
# A local .env file CANNOT configure hosted Supabase function secrets by itself.
# =============================================================================
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_API_KEY=   # optional fallback if Gemini key missing
# GROQ_MODEL=openai/gpt-oss-20b
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=https://YOUR_PROJECT.supabase.co/functions/v1/linkedin-oauth-callback
# LINKEDIN_VERSION=202609
# TOKEN_ENCRYPTION_KEY=
# CRON_INTERNAL_SECRET=
# APP_BASE_URL=https://your-pages-domain.pages.dev
# OWNER_EMAIL=you@example.com
# BOOTSTRAP_SECRET=
# PUBLISHING_MODE=review
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# =============================================================================
# Supabase Vault values used by pg_cron + pg_net (set in SQL after migrate)
# =============================================================================
# vault_project_url = https://YOUR_PROJECT.supabase.co
# vault_anon_key    = YOUR_PUBLISHABLE_OR_ANON_KEY
# vault_cron_secret = same value as CRON_INTERNAL_SECRET
